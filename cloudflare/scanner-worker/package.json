{
  "name": "@nexus/scanner-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "python3 ../../scripts/scanner_identity.py --check && wrangler deploy",
    "pretest": "python3 ../../scripts/scanner_identity.py --check",
    "prebuild": "python3 ../../scripts/scanner_identity.py --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.147.0"
  }
}
